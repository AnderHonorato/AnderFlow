// ============================================
// CRM — Leads, tickets, feedback e briefings
// ============================================

model Lead {
  id          String    @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  source      String?
  status      String    @default("NEW")
  score       Int       @default(0)
  value       Float?
  ownerId     String?
  notes       String?
  tags        String    @default("[]")
  metadata    String?
  convertedAt DateTime?
  leadScore   Float?
  aiInsight   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner User? @relation("LeadOwner", fields: [ownerId], references: [id])
  @@index([status, ownerId])
}

model Ticket {
  id               String    @id @default(cuid())
  number           Int       @default(0)
  title            String
  description      String
  status           String    @default("OPEN")
  priority         String    @default("MEDIUM")
  category         String?
  creatorId        String
  assigneeId       String?
  resolvedAt       DateTime?
  closedAt         DateTime?
  slaDeadline      DateTime?
  tags             String    @default("[]")
  metadata         String?
  aiCategory       String?
  aiPriority       String?
  aiSuggestedReply String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  creator  User  @relation("TicketCreator", fields: [creatorId], references: [id])
  assignee User? @relation("TicketAssignee", fields: [assigneeId], references: [id])

  @@index([status])
  @@index([creatorId])
  @@index([assigneeId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String
  rating    Int?
  status    String   @default("pending")
  votes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model BriefingDraft {
  id           String   @id @default(cuid())
  userId       String
  categoryId   String
  currentStage Int      @default(0)
  currentStep  Int      @default(0)
  answers      String   @default("{}")
  submitted    Boolean  @default(false)
  projectId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
}
