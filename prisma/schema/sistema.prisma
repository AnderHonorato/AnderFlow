// ============================================
// SISTEMA — Arquivos, configurações, auditoria e automações
// ============================================

model File {
  id           String    @id @default(cuid())
  name         String
  originalName String
  mimeType     String
  size         Int
  url          String
  key          String?
  folderId     String?
  projectId    String?
  taskId       String?
  messageId    String?
  uploadedBy   String
  version      Int       @default(1)
  isPublic     Boolean   @default(false)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  folder  FileFolder? @relation(fields: [folderId], references: [id])
  project Project?    @relation(fields: [projectId], references: [id])
  task    Task?       @relation(fields: [taskId], references: [id])
  message Message?    @relation(fields: [messageId], references: [id])
  user    User        @relation(fields: [uploadedBy], references: [id])
}

model FileFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  parent   FileFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children FileFolder[] @relation("FolderHierarchy")
  files    File[]
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  group String @default("general")
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  action    String
  details   String?
  userId    String
  projectId String?
  metadata  String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  action      String
  entity      String
  entityId    String?
  description String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Automation {
  id          String    @id @default(cuid())
  name        String
  description String?
  trigger     String
  conditions  String?
  actions     String
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  runCount    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model KnowledgeBase {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String
  slug        String   @unique
  isPublished Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklyCheckin {
  id        String   @id @default(cuid())
  clientId  String
  projectId String?
  mood      Int
  week      Int
  createdAt DateTime @default(now())
}

model ProjectTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  tasks       String
  createdAt   DateTime @default(now())
}

model WebhookEndpoint {
  id         String            @id @default(cuid())
  url        String
  secret     String
  events     String[]
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  endpointId   String
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?
  success      Boolean  @default(false)
  attempts     Int      @default(1)
  createdAt    DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])
}

model SavedReport {
  id        String   @id @default(cuid())
  name      String
  config    Json
  ownerId   String
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])
}

model OKR {
  id        String   @id @default(cuid())
  projectId String
  objective String
  createdAt DateTime @default(now())

  keyResults KeyResult[]
}

model KeyResult {
  id           String @id @default(cuid())
  okrId        String
  title        String
  currentValue Float  @default(0)
  targetValue  Float
  unit         String @default("%")

  okr OKR @relation(fields: [okrId], references: [id])
}

model TaskFeedback {
  id        String   @id @default(cuid())
  projectId String
  stepId    Int
  clientId  String
  approved  Boolean
  comment   String?
  createdAt DateTime @default(now())
}

model ClientContact {
  id              String   @id @default(cuid())
  clientId        String
  name            String
  email           String
  role            String   @default("Contato")
  phone           String?
  canAccessPortal Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model StatusComponent {
  id     String @id @default(cuid())
  name   String
  status String @default("operational")
  order  Int    @default(0)
}

model StatusIncident {
  id         String    @id @default(cuid())
  title      String
  message    String
  status     String    @default("investigating")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model ContractVersion {
  id         String   @id @default(cuid())
  contractId String
  content    String
  version    Int
  createdAt  DateTime @default(now())
  createdBy  String
}

model BriefingSchema {
  id        String   @id @default(cuid())
  fields    Json
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  provider  String
  label     String?
  keyHash   String
  keyMask   String
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalFlow {
  id          String    @id @default(cuid())
  entityType  String
  entityId    String
  status      String    @default("pending")
  requiredBy  String
  approvedAt  DateTime?
  rejectedAt  DateTime?
  comment     String?
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([requiredBy])
  @@index([status])
}

model FaqCache {
  id        String   @id @default(cuid())
  question  String
  answer    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model ChangelogEntry {
  id          String    @id @default(cuid())
  version     String
  title       String
  description String
  type        String    @default("feature")
  isPublic    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  @@index([isPublic, publishedAt])
}

model ApiKeyUsage {
  id         String   @id @default(cuid())
  keyId      String
  endpoint   String
  method     String
  statusCode Int
  createdAt  DateTime @default(now())
  @@index([keyId, createdAt])
}

model LegalDocument {
  id        String   @id @default(cuid())
  type      String   @unique
  content   String
  version   String
  updatedAt DateTime @updatedAt
}

model UserConsent {
  id         String   @id @default(cuid())
  userId     String
  docType    String
  docVersion String
  ip         String?
  createdAt  DateTime @default(now())
  @@index([userId, docType])
}

model BackupLog {
  id        String   @id @default(cuid())
  filename  String
  size      Int
  status    String
  createdAt DateTime @default(now())
}

model CodeReview {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  codeSnippet String?
  language    String   @default("javascript")
  status      String   @default("pending")
  authorId    String
  reviewerId  String?
  createdAt   DateTime @default(now())
  comments   CodeReviewComment[]
  @@index([projectId, status])
}

model CodeReviewComment {
  id        String   @id @default(cuid())
  reviewId  String
  content   String
  lineRef   Int?
  authorId  String
  createdAt DateTime @default(now())
  review CodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  @@index([reviewId])
}

model ScheduledCall {
  id          String   @id @default(cuid())
  projectId   String?
  clientId    String
  scheduledBy String
  title       String
  description String?
  scheduledAt DateTime
  duration    Int      @default(60)
  meetLink    String?
  status      String   @default("scheduled")
  notes       String?
  createdAt   DateTime @default(now())
  @@index([clientId, scheduledAt])
  @@index([projectId])
}

model ProjectBudgetHistory {
  id        String   @id @default(cuid())
  projectId String
  oldValue  Float?
  newValue  Float
  reason    String?
  changedBy String
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id])
  @@index([projectId, createdAt])
}

model ContextualTipDismissal {
  id        String   @id @default(cuid())
  userId    String
  tipKey    String
  dismissedAt DateTime @default(now())
  @@unique([userId, tipKey])
}

model BotActionLog {
  id          String   @id @default(cuid())
  botId       String
  botName     String
  botRole     String
  action      String
  endpoint    String?
  method      String?
  requestBody Json?
  status      String   @default("pending")
  result      String?
  error        String?
  prompt       String?
  aiResponse   String?
  tokensUsed   Int?
  costEstimate Float?
  createdAt    DateTime @default(now())

  @@index([botId, createdAt])
  @@index([status])
  @@index([createdAt])
}
