// ============================================
// CONTRATO — Assinatura digital e gestão contratual
// ============================================

model Contract {
  id             String    @id @default(cuid())
  title          String
  content        String
  clientId       String
  projectId      String?
  organizationId String?
  status         String    @default("DRAFT")
  startDate      DateTime?
  endDate        DateTime?
  value          Float?
  signedAt       DateTime?
  signature      String?
  signatureUrl   String?
  signerIp       String?
  pdfUrl         String?
  autoRenew      Boolean   @default(false)
  loyaltyMonths  Int?
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client       User          @relation("ContractClient", fields: [clientId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model ProposalVersion {
  id          String    @id @default(cuid())
  projectId   String
  value       Float
  message     String
  version     Int
  sentAt      DateTime  @default(now())
  response    String?
  respondedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model DeliveryChecklist {
  id          String    @id @default(cuid())
  projectId   String    @unique
  items       Json
  completedAt DateTime?
  completedBy String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DeadlineAlert {
  id        String   @id @default(cuid())
  projectId String
  type      String
  sentAt    DateTime @default(now())

  @@unique([projectId, type])
}

model UiFeedback {
  id        String   @id @default(cuid())
  page      String
  helpful   Boolean
  userId    String
  createdAt DateTime @default(now())

  @@index([page])
}
